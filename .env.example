# Sao chép thành .env rồi chỉnh nếu cần: cp .env.example .env
# Giá trị dưới đây chỉ dùng cho môi trường phát triển.

POSTGRES_USER=notify
POSTGRES_PASSWORD=notify_dev_password
POSTGRES_DB=notification_db

RABBITMQ_USER=notify
RABBITMQ_PASSWORD=notify_dev_password

# Port mở ra máy host
API_PORT=5000
ADMIN_PORT=5001
STATS_PORT=5002
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Số job tối đa mỗi worker giữ chưa ack
WORKER_PREFETCH=10
# Số job mỗi worker xử lý song song
WORKER_CONCURRENCY=1

# Tỉ lệ lỗi ngẫu nhiên của bộ gửi giả lập (0–1)
MOCK_FAILURE_RATE=0.1

# Bộ gửi: Mock (giả lập mọi kênh, mặc định) hoặc Real (gửi thật Email qua SMTP và Telegram qua bot;
# SMS chưa tích hợp nhà cung cấp nên báo lỗi). Giá trị cũ "Smtp" vẫn được hiểu là Real.
SENDER_MODE=Mock

# Token bot Telegram: nhắn /newbot cho @BotFather trên Telegram để tạo bot và nhận token.
# Người nhận nhắn /start cho bot để vào danh bạ. Chỉ điền trong file .env (không đưa lên Git).
TELEGRAM_BOT_TOKEN=

# Thông tin SMTP khi SENDER_MODE=Real. Chỉ điền trong file .env (không đưa lên Git).
# Gmail: bật xác minh 2 bước, tạo App Password tại https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<địa chỉ Gmail>, SMTP_FROM=<địa chỉ Gmail>
# Mailpit (thử nghiệm, không gửi thật): SMTP_HOST=mailpit, SMTP_PORT=1025, để trống SMTP_USER/SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Hệ thống gửi thông báo

# Định dạng log: text (dễ đọc khi demo) hoặc json (log có cấu trúc)
LOG_FORMAT=text

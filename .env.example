# Sao chép thành .env rồi chỉnh nếu cần: cp .env.example .env
# Giá trị dưới đây chỉ dùng cho môi trường phát triển.

POSTGRES_USER=notify
POSTGRES_PASSWORD=notify_dev_password
POSTGRES_DB=notification_db

RABBITMQ_USER=notify
RABBITMQ_PASSWORD=notify_dev_password

# Port mở ra máy host
API_PORT=5000
ADMIN_PORT=5001
STATS_PORT=5002
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Số job tối đa mỗi worker giữ chưa ack
WORKER_PREFETCH=10
# Số job mỗi worker xử lý song song
WORKER_CONCURRENCY=1

# Tỉ lệ lỗi ngẫu nhiên của bộ gửi giả lập (0–1)
MOCK_FAILURE_RATE=0.1

# Định dạng log: text (dễ đọc khi demo) hoặc json (log có cấu trúc)
LOG_FORMAT=text

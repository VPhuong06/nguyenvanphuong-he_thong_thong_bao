@if (TotalPages > 1)
{
    <nav class="pager">
        <button class="btn btn-small" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">‹ Trước</button>
        <span>Trang @Page / @TotalPages</span>
        <button class="btn btn-small" disabled="@(Page >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">Sau ›</button>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
}

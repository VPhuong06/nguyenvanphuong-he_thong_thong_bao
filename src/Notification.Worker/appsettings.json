{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=notification_db;Username=notify;Password=notify_dev_password"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "notify",
    "Password": "notify_dev_password",
    "PrefetchCount": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [worker] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
